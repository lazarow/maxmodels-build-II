+                    S.default_vsids_activity = parseDouble(in);
+                    int n_vars = parseInt(in);
+                    for (int i = 0; i < n_vars; i++) {
+                        int var = parseInt(in);
+                        double val = parseDouble(in);
+                        S.vsids_initial_activity[var - 1] = val;
