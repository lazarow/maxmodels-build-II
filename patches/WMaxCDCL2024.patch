diff --git a/code/utils/ParseUtils.h b/code/utils/ParseUtils.h
--- a/code/utils/ParseUtils.h
+++ b/code/utils/ParseUtils.h
@@ -125,6 +125,33 @@
     /* } */
 
 
+
+    template<class B>
+    static double parseDouble(B& in) {
+        double val = 0.0;
+        skipWhitespace(in);
+        bool neg = false;
+        if (*in == '-') { neg = true; ++in; }
+        else if (*in == '+') ++in;
+        if ((*in < '0' || *in > '9') && *in != '.')
+            fprintf(stderr, "PARSE ERROR! Unexpected char: %c\n", *in), exit(3);
+        // Integer part
+        while (*in >= '0' && *in <= '9')
+            val = val * 10.0 + (*in - '0'),
+            ++in;
+        // Fractional part
+        if (*in == '.') {
+            ++in;
+            double frac = 1.0;
+            while (*in >= '0' && *in <= '9') {
+                frac /= 10.0;
+                val += (*in - '0') * frac;
+                ++in;
+            }
+        }
+        return neg ? -val : val;
+    }
+
     // String matching: in case of a match the input iterator will be advanced the corresponding
     // number of characters.
     template<class B>
