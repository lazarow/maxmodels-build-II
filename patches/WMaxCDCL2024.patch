+                } else if (eagerMatch(in, "c CHB")) {
+                    S.default_chb_activity = parseDouble(in);
+                    int n_vars = parseInt(in);
+                    for (int i = 0; i < n_vars; i++) {
+                        int var = parseInt(in);
+                        double val = parseDouble(in);
+                        S.chb_initial_activity[var - 1] = val;
+                    }
+                } else if (eagerMatch(in, "c POLARITY")) {
+                    int n_vars = parseInt(in);
+                    for (int i = 0; i < n_vars; i++) {
+                        int var = parseInt(in);
+                        bool val = (parseInt(in) != 0);
+                        S.initial_polarity[var - 1] = val;
+                    }
+                }
                 skipLine(in);
