adj(U,V) :- edge(U,V).
adj(U,V) :- edge(V,U).
{in(V)} :- node(V).
dominated(V) :- in(V).
dominated(V) :- in(U), adj(U,V).
:- node(V), not dominated(V).
:- bound(B), #sum{W,V : in(V), weight(V,W)} > B.
:~ in(V), weight(V,W). [W@1,V]
