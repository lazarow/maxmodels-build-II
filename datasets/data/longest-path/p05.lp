{in(I, J)} :- edge(I, J, W).
r(X) :- source(X).
r(Y) :- in(X, Y), r(X).
:- not r(X), target(X).
:- node(X), #count{Y: in(X, Y)} >= 2.
:- node(Y), #count{X: in(X, Y)} >= 2.
:- in(X, Y), target(X).
:- in(X, Y), source(Y).
:- in(X, Y), not r(X).
:~ not in(I, J), edge(I, J, W). [W@1, I, J]
