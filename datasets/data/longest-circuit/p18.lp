{in(U,V)} :- edge(U,V,_).
in_cycle(U) :- in(U,_).
in_cycle(V) :- in(_,V).
:- in_cycle(U), #count{V : in(U,V)} != 1.
:- in_cycle(V), #count{U : in(U,V)} != 1.
cycle_exists :- in_cycle(V).
1 { start(V) : in_cycle(V) } 1 :- cycle_exists.
reach(V) :- start(V).
reach(V) :- reach(U), in(U,V).
:- in_cycle(V), not reach(V).
:~ edge(U,V,W), not in(U,V). [W@1,U,V]
